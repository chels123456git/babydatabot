# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file (it contains your bot's secret token).

# Get this from @BotFather on Telegram (see setup instructions).
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your Telegram numeric user ID and your partner's (see setup instructions
# for how to get these from @userinfobot).
MY_USER_ID=111111111
PARTNER_USER_ID=222222222

# IANA timezone name used to DISPLAY times (data is stored in UTC
# internally, so this is safe to change any time). Examples:
# Asia/Singapore, America/New_York, Europe/London
LOCAL_TZ=Asia/Singapore

# Path to the SQLite database file. On Render/Railway, point this at a
# mounted persistent disk if you don't want data lost on redeploy.
DB_PATH=babydata.db

# --- Only needed if deploying with flask_app.py (webhook mode, e.g. on
# --- PythonAnywhere's free tier) instead of `python bot.py` (polling): ---

# A long random string only you know. It becomes part of the webhook URL
# Telegram posts updates to, so it doubles as a basic secret check.
WEBHOOK_SECRET=choose-a-long-random-string-here

# PythonAnywhere's free "Beginner" accounts can only make outbound requests
# through this proxy. Leave unset on Render/Railway/local (no proxy needed).
BOT_HTTP_PROXY=http://proxy.server:3128
