# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file (it contains your bot's secret token).

# Get this from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your Telegram numeric user ID and your partner's (get these from @userinfobot).
MY_USER_ID=111111111
PARTNER_USER_ID=222222222

# IANA timezone name used to DISPLAY times (data is stored in UTC internally).
LOCAL_TZ=Asia/Singapore

# Path to the SQLite database file.
DB_PATH=babydata.db
